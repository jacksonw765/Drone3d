# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_URL=redis://redis:6379/0

# NodeODM
NODEODM_HOST=nodeodm
NODEODM_PORT=3000
NODEODM_MEMORY_LIMIT=20G

# Superuser (auto-created on first boot)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=drone3d-admin
DJANGO_SUPERUSER_EMAIL=admin@drone3d.local

# ── Ollama (AI Analysis) ─────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_PRIMARY_MODEL=llama3.2-vision:11b
OLLAMA_TEXT_MODEL=llama3.2-vision:11b
AI_ANALYSIS_ENABLED=true
AI_TILE_SIZE=512
AI_CONFIDENCE_THRESHOLD=0.4

# ── TAK Integration ──────────────────────────────────────
TAK_ENABLED=false
TAK_SERVER_HOST=
TAK_SERVER_PORT=8087
